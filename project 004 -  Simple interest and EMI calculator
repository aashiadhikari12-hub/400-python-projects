        "# EMI stands for equated monthly installment. It is the fixed monthly paymentor borrower makes towards the loan\n",
        "# This calculator estimates the monthly payment, total repayment and total interest\n",
        "# EMI = p * r * (1 + r) ** n / ((1 + r) ** n - 1)\n",
        "print(\"----EMI Calculator----\")\n",
        "principal = float(input(\"enter the value of original amount:\"))\n",
        "annual_rate = float(input(\" Enter the value of interest rate:\"))\n",
        "years = float(input(\"Enter the number of years:\"))\n",
        "if principal <= 0 or annual_rate <= 0 or years <= 0:\n",
        "  print(\"Please enter a valid data only\")\n",
        "else:\n",
        "  rate = annual_rate / 100\n",
        "  months =  years * 12\n",
        "  emi = principal * rate * (1 + rate) ** months / (( 1+ rate )** months - 1)\n",
        "  total = emi * months\n",
        "  print(f\" The monthly Emi is {emi:.2f}\")\n",
        "  print(f\" The total emi calculation is {total:,.2f}\")"
      ],
